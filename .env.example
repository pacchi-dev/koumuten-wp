# ローカル開発用の設定。本番の認証情報は絶対に入れないこと。
# 実際に使う値は .env に置く（.gitignore 済み）。

# データベース
DB_NAME=koumuten
DB_USER=koumuten
DB_PASSWORD=koumuten
DB_ROOT_PASSWORD=root

# ポート（既存 portfolio_wordpress の 8080/8025 と衝突させない）
WP_PORT=8090
MAILPIT_PORT=8035

# WordPress サイト設定（bin/setup.sh が使用）
WP_URL=http://localhost:8090
WP_TITLE="ソラノワ工務店｜姫路の注文住宅・リノベーション"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.test

# ---------------------------------------------------------------
# 本番デプロイ（bin/deploy.sh）。ローカル開発だけなら不要。
# 共用サーバーは FTPS（明示的・port 21）で受け付ける。
# FTP_USER は cPanel の「FTP アカウント」一覧に出る完全な名前を書く。
# FTP_REMOTE_DIR は公開ディレクトリからの相対位置。
# ---------------------------------------------------------------
FTP_HOST=example.com
FTP_USER=deploy@example.com
FTP_PASSWORD=
FTP_REMOTE_DIR=/koumuten
DEPLOY_URL=https://example.com/koumuten
